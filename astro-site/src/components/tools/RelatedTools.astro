---
import { getTool } from "../../data/tools";

interface Props {
  slugs: string[];
  title?: string;
}
const { slugs, title = "Related tools" } = Astro.props;
const related = slugs.map((s) => getTool(s)).filter(Boolean);
---

{
  related.length > 0 && (
    <section class="related">
      <h2 class="related__title">{title}</h2>
      <div class="related__grid">
        {related.map((tool) => (
          <a class="related__card" href={`/tools/${tool!.slug}/`} style={`--accent:${tool!.accent}`}>
            <span class="related__icon" aria-hidden="true">{tool!.icon}</span>
            <span class="related__body">
              <strong>{tool!.title}</strong>
              <span>{tool!.description}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related__title { font-size: clamp(1.4rem, 3.5vw, 1.9rem); margin-bottom: 1.25rem; }
  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .related__card {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.1rem;
    background: var(--cc-surface);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-md);
    box-shadow: var(--cc-shadow-soft);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .related__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--cc-shadow-hover);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--cc-border));
  }
  .related__icon {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 12px; font-size: 1.25rem;
    background: color-mix(in srgb, var(--accent) 14%, var(--cc-surface));
    flex-shrink: 0;
  }
  .related__body { display: flex; flex-direction: column; gap: 0.2rem; }
  .related__body strong { font-size: 1rem; }
  .related__body span { font-size: 0.86rem; color: var(--cc-muted); }
  @media (min-width: 720px) {
    .related__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
