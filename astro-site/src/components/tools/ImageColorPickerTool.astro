---
// Image Color Picker — extract a palette from an image, 100% in-browser.
---

<div class="cc-tool" data-imgpicker>
  <label class="ip__drop" data-drop>
    <input type="file" accept="image/*" data-file class="cc-visually-hidden" />
    <span class="ip__drop-inner">
      <span class="ip__icon" aria-hidden="true">🖼️</span>
      <strong>Choose an image</strong>
      <span class="ip__hint">or drag &amp; drop · processed privately in your browser</span>
    </span>
  </label>

  <div class="ip__result" data-result hidden>
    <div class="ip__preview">
      <img data-img alt="Your uploaded image preview" />
    </div>
    <div class="ip__palette">
      <div class="ip__palette-head">
        <h3>Extracted palette</h3>
        <button type="button" class="cc-copy" data-copy-all>Copy all</button>
      </div>
      <div class="cc-palette ip__swatches" data-swatches></div>
    </div>
  </div>
</div>

<style>
  .ip__drop {
    display: block;
    border: 2px dashed var(--cc-border-strong);
    border-radius: var(--cc-radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
    background: var(--cc-surface-soft);
  }
  .ip__drop:hover, .ip__drop[data-drag] {
    border-color: var(--cc-primary);
    background: var(--cc-primary-soft);
  }
  .ip__drop-inner { display: flex; flex-direction: column; gap: 0.35rem; align-items: center; }
  .ip__icon { font-size: 2rem; }
  .ip__hint { color: var(--cc-faint); font-size: 0.85rem; }
  .ip__result { margin-top: 1.5rem; display: grid; gap: 1.5rem; }
  .ip__preview img {
    width: 100%; border-radius: var(--cc-radius-md); border: 1px solid var(--cc-border);
    max-height: 320px; object-fit: cover;
  }
  .ip__palette-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
  .ip__palette-head h3 { font-size: 1rem; }
  .ip__swatches { grid-template-columns: repeat(3, 1fr); }
  @media (min-width: 720px) {
    .ip__result { grid-template-columns: 1fr 1fr; align-items: start; }
    .ip__swatches { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import { rgbToHex, readableTextColor, type RGB } from "../../utils/color";
  import { copyText, flashCopied } from "../../scripts/clipboard";

  const root = document.querySelector<HTMLElement>("[data-imgpicker]");
  if (root) {
    const fileInput = root.querySelector<HTMLInputElement>("[data-file]")!;
    const drop = root.querySelector<HTMLElement>("[data-drop]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const img = root.querySelector<HTMLImageElement>("[data-img]")!;
    const swatches = root.querySelector<HTMLElement>("[data-swatches]")!;
    const copyAll = root.querySelector<HTMLButtonElement>("[data-copy-all]")!;
    let current: string[] = [];

    function extract(image: HTMLImageElement): string[] {
      const canvas = document.createElement("canvas");
      const maxDim = 160; // downscale for speed
      const scale = Math.min(1, maxDim / Math.max(image.naturalWidth, image.naturalHeight));
      canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
      canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
      const ctx = canvas.getContext("2d", { willReadFrequently: true });
      if (!ctx) return [];
      ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
      const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);

      // Bucket colors into a coarse grid and count frequency.
      const buckets = new Map<string, { count: number; r: number; g: number; b: number }>();
      for (let i = 0; i < data.length; i += 4) {
        const a = data[i + 3];
        if (a < 125) continue; // skip transparent
        const r = data[i], g = data[i + 1], b = data[i + 2];
        const key = `${r >> 4}-${g >> 4}-${b >> 4}`; // 4-bit per channel
        const bucket = buckets.get(key);
        if (bucket) {
          bucket.count++; bucket.r += r; bucket.g += g; bucket.b += b;
        } else {
          buckets.set(key, { count: 1, r, g, b });
        }
      }
      const sorted = [...buckets.values()].sort((a, b) => b.count - a.count).slice(0, 6);
      return sorted.map((s) => {
        const avg: RGB = {
          r: Math.round(s.r / s.count),
          g: Math.round(s.g / s.count),
          b: Math.round(s.b / s.count),
        };
        return rgbToHex(avg);
      });
    }

    function renderPalette() {
      swatches.innerHTML = current
        .map((c) => {
          const text = readableTextColor({ r: parseInt(c.slice(1, 3), 16), g: parseInt(c.slice(3, 5), 16), b: parseInt(c.slice(5, 7), 16) });
          return `<button type="button" class="cc-palette__chip" data-copy="${c}" aria-label="Copy ${c.toUpperCase()}">
            <span class="cc-palette__color" style="background:${c};color:${text}"></span>
            <span class="cc-palette__hex">${c.toUpperCase()}</span>
          </button>`;
        })
        .join("");
      swatches.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          if (await copyText(btn.dataset.copy!)) flashCopied(btn.querySelector(".cc-palette__hex") as HTMLElement, "Copied!");
        });
      });
    }

    function handleFile(file: File) {
      if (!file.type.startsWith("image/")) return;
      const url = URL.createObjectURL(file);
      img.onload = () => {
        current = extract(img);
        renderPalette();
        result.hidden = false;
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    fileInput.addEventListener("change", () => {
      if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
    });
    ["dragover", "dragenter"].forEach((ev) =>
      drop.addEventListener(ev, (e) => { e.preventDefault(); drop.setAttribute("data-drag", ""); })
    );
    ["dragleave", "drop"].forEach((ev) =>
      drop.addEventListener(ev, () => drop.removeAttribute("data-drag"))
    );
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
    copyAll.addEventListener("click", async () => {
      if (current.length && (await copyText(current.map((c) => c.toUpperCase()).join(", ")))) {
        flashCopied(copyAll, "Copied!");
      }
    });
  }
</script>
