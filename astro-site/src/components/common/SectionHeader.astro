---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, subtitle, align = "left", class: className = "" } = Astro.props;
---

<header class={`cc-section-head cc-section-head--${align} ${className}`}>
  {eyebrow && <p class="cc-section-head__eyebrow">{eyebrow}</p>}
  <h2 class="cc-section-head__title">{title}</h2>
  {subtitle && <p class="cc-section-head__subtitle">{subtitle}</p>}
</header>

<style>
  .cc-section-head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .cc-section-head--center {
    align-items: center;
    text-align: center;
  }
  .cc-section-head__eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cc-primary);
  }
  .cc-section-head__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }
  .cc-section-head__subtitle {
    font-size: 1.05rem;
    color: var(--cc-muted);
    max-width: 40rem;
  }
  .cc-section-head--center .cc-section-head__subtitle {
    margin-inline: auto;
  }
</style>
