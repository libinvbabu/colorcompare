---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
}
const { faqs, title = "Frequently asked questions" } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq">
      <h2 class="faq__title">{title}</h2>
      <div class="faq__list">
        {faqs.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">
              <span>{f.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq__title { font-size: clamp(1.4rem, 3.5vw, 1.9rem); margin-bottom: 1.25rem; }
  .faq__list { display: grid; gap: 0.75rem; }
  .faq__item {
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-md);
    background: var(--cc-surface);
    overflow: hidden;
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    background: var(--cc-primary);
    border-radius: 2px;
    transition: transform 0.2s ease;
  }
  .faq__icon::before { inset: 7px 0; height: 2px; }
  .faq__icon::after { inset: 0 7px; width: 2px; }
  .faq__item[open] .faq__icon::after { transform: scaleY(0); }
  .faq__a {
    padding: 0 1.2rem 1.2rem;
    color: var(--cc-muted);
  }
</style>
