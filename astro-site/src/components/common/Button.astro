---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  type?: "button" | "submit";
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  ariaLabel,
} = Astro.props;

const cls = `cc-btn cc-btn--${variant} cc-btn--${size} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  .cc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--cc-radius-pill);
    border: 1px solid transparent;
    cursor: pointer;
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease,
      border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }
  .cc-btn--md {
    padding: 0.7rem 1.25rem;
    font-size: 0.95rem;
  }
  .cc-btn--lg {
    padding: 0.95rem 1.6rem;
    font-size: 1.05rem;
  }
  .cc-btn--primary {
    background: var(--cc-gradient-brand);
    color: #fff;
    box-shadow: 0 12px 30px rgba(109, 93, 252, 0.35);
  }
  .cc-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 38px rgba(109, 93, 252, 0.42);
  }
  .cc-btn--secondary {
    background: var(--cc-surface);
    color: var(--cc-text);
    border-color: var(--cc-border-strong);
    box-shadow: var(--cc-shadow-soft);
  }
  .cc-btn--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--cc-primary);
    color: var(--cc-primary-dark);
  }
  .cc-btn--ghost {
    background: transparent;
    color: var(--cc-text);
  }
  .cc-btn--ghost:hover {
    background: var(--cc-surface-soft);
  }
</style>
