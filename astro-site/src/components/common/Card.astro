---
interface Props {
  href?: string;
  hover?: boolean;
  class?: string;
  /** Optional accent color shown as a top border / glow. */
  accent?: string;
}

const { href, hover = false, class: className = "", accent } = Astro.props;
const cls = `cc-surface ${hover ? "cc-surface--hover" : ""} ${className}`;
const style = accent ? `--accent:${accent}` : undefined;
const Tag = (href ? "a" : "div") as any;
---

<Tag class={cls} href={href} style={style} data-accent={accent ? "" : undefined}>
  <slot />
</Tag>

<style>
  .cc-surface {
    position: relative;
    display: block;
    background: var(--cc-surface);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-lg);
    box-shadow: var(--cc-shadow-soft);
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.2s ease;
  }
  .cc-surface--hover:hover {
    transform: translateY(-4px);
    box-shadow: var(--cc-shadow-hover);
    border-color: color-mix(in srgb, var(--accent, var(--cc-primary)) 40%, var(--cc-border));
  }
  .cc-surface[data-accent]::before {
    content: "";
    position: absolute;
    inset-inline: 1.5rem;
    top: 0;
    height: 3px;
    border-radius: 0 0 4px 4px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cc-surface--hover[data-accent]:hover::before {
    opacity: 1;
  }
</style>
