---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import { breadcrumbSchema } from "../../utils/schema";

const title = "Blog — Color Theory, Palettes & Accessibility Guides";
const description =
  "Practical guides on color theory, website color combinations, accessible UI colors, and branding color psychology from the ColorCompare team.";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);

// Unique tags for filter pills (non-functional client filter kept simple).
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].slice(0, 8);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
];
---

<BaseLayout title={title} description={description} canonical="/blog/" schemas={schemas}>
  <Breadcrumbs crumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]} />

  <Container>
    <header class="blog-index__hero">
      <h1>The ColorCompare blog</h1>
      <p>Practical, no-fluff guides on working with color — theory, palettes, accessibility, and branding.</p>
    </header>

    {
      featured && (
        <a
          class="blog-feature"
          href={`/blog/${featured.id}/`}
          style={`--c1:${featured.data.cover[0]};--c2:${featured.data.cover[1]}`}
        >
          <span class="blog-feature__cover" aria-hidden="true" />
          <span class="blog-feature__body">
            <span class="blog-feature__badge">Featured</span>
            <strong class="blog-feature__title">{featured.data.title}</strong>
            <span class="blog-feature__desc">{featured.data.description}</span>
            <span class="blog-feature__meta">{fmt(featured.data.pubDate)}</span>
          </span>
        </a>
      )
    }

    {
      tags.length > 0 && (
        <ul class="blog-tags" aria-label="Topics">
          {tags.map((t) => <li class="blog-tag">{t}</li>)}
        </ul>
      )
    }

    <div class="blog-grid">
      {
        rest.map((post) => (
          <a class="blog-card" href={`/blog/${post.id}/`}>
            <span
              class="blog-card__cover"
              style={`background:linear-gradient(135deg, ${post.data.cover[0]}, ${post.data.cover[1]})`}
              aria-hidden="true"
            />
            <span class="blog-card__body">
              <span class="blog-card__date">{fmt(post.data.pubDate)}</span>
              <strong class="blog-card__title">{post.data.title}</strong>
              <span class="blog-card__desc">{post.data.description}</span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</BaseLayout>

<style>
  .blog-index__hero { max-width: 42rem; margin: 1.5rem 0 2.5rem; }
  .blog-index__hero h1 { font-size: clamp(2rem, 5.5vw, 3rem); margin-bottom: 0.75rem; }
  .blog-index__hero p { color: var(--cc-muted); font-size: 1.1rem; }

  .blog-feature {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-lg);
    overflow: hidden;
    box-shadow: var(--cc-shadow-soft);
    background: var(--cc-surface);
    margin-bottom: 2rem;
    transition: transform 0.2s ease, box-shadow 0.25s ease;
  }
  .blog-feature:hover { transform: translateY(-4px); box-shadow: var(--cc-shadow-hover); }
  .blog-feature__cover {
    min-height: 180px;
    background: linear-gradient(135deg, var(--c1), var(--c2));
  }
  .blog-feature__body { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; }
  .blog-feature__badge {
    align-self: flex-start;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--cc-primary-dark); background: var(--cc-primary-soft);
    padding: 0.3rem 0.65rem; border-radius: var(--cc-radius-pill);
  }
  .blog-feature__title { font-size: clamp(1.3rem, 3vw, 1.7rem); }
  .blog-feature__desc { color: var(--cc-muted); }
  .blog-feature__meta { color: var(--cc-faint); font-size: 0.85rem; }

  .blog-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0 0 1.75rem; }
  .blog-tag {
    font-size: 0.8rem; font-weight: 600; color: var(--cc-muted);
    background: var(--cc-surface); border: 1px solid var(--cc-border);
    padding: 0.4rem 0.8rem; border-radius: var(--cc-radius-pill); text-transform: capitalize;
  }

  .blog-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .blog-card {
    display: flex; flex-direction: column;
    background: var(--cc-surface); border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-lg); box-shadow: var(--cc-shadow-soft);
    overflow: hidden; transition: transform 0.2s ease, box-shadow 0.25s ease;
  }
  .blog-card:hover { transform: translateY(-4px); box-shadow: var(--cc-shadow-hover); }
  .blog-card__cover { height: 130px; }
  .blog-card__body { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.1rem 1.2rem 1.3rem; }
  .blog-card__date { font-size: 0.75rem; font-weight: 600; color: var(--cc-faint); text-transform: uppercase; letter-spacing: 0.04em; }
  .blog-card__title { font-size: 1.1rem; line-height: 1.3; }
  .blog-card__desc { font-size: 0.9rem; color: var(--cc-muted); }

  @media (min-width: 760px) {
    .blog-feature { grid-template-columns: 1.1fr 1fr; }
    .blog-feature__cover { min-height: 100%; }
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1040px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
