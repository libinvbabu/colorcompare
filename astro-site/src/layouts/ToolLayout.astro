---
import "../styles/tools.css";
import Container from "../components/common/Container.astro";
import Breadcrumbs from "../components/common/Breadcrumbs.astro";
import Badge from "../components/common/Badge.astro";
import Faq from "../components/common/Faq.astro";
import AdSlot from "../components/ads/AdSlot.astro";
import ToolRenderer from "../components/tools/ToolRenderer.astro";
import RelatedTools from "../components/tools/RelatedTools.astro";
import type { Tool } from "../data/tools";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<Breadcrumbs
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Tools", path: "/tools/" },
    { name: tool.title, path: `/tools/${tool.slug}/` },
  ]}
/>

<article>
  <Container>
    <header class="tool-hero">
      <Badge variant="primary" icon={tool.icon}>{tool.category}</Badge>
      <h1 class="tool-hero__title">{tool.heroTitle}</h1>
      <p class="tool-hero__subtitle">{tool.heroSubtitle}</p>
    </header>

    <ToolRenderer slug={tool.slug} />

    <AdSlot slot="" format="horizontal" />
  </Container>

  <Container width="narrow">
    <div class="cc-prose tool-content">
      {tool.intro.map((p) => <p>{p}</p>)}

      <h2>How to use the {tool.title}</h2>
      <ol class="tool-steps">
        {tool.howTo.map((s) => (
          <li>
            <strong>{s.title}.</strong> {s.text}
          </li>
        ))}
      </ol>

      <h2>Practical examples</h2>
      <div class="tool-examples">
        {tool.examples.map((ex) => (
          <div class="tool-example">
            <strong>{ex.label}</strong>
            <span>{ex.text}</span>
          </div>
        ))}
      </div>

      <h2>Why the {tool.title} matters</h2>
      <ul>
        {tool.whyItMatters.map((w) => <li>{w}</li>)}
      </ul>
    </div>

    <div class="tool-faq">
      <Faq faqs={tool.faqs} />
    </div>
  </Container>

  <Container>
    <div class="tool-related">
      <RelatedTools slugs={tool.relatedTools} />
    </div>
    <AdSlot slot="" format="horizontal" />
  </Container>
</article>

<style>
  .tool-hero {
    text-align: center;
    max-width: 44rem;
    margin: 1.5rem auto 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .tool-hero__title {
    font-size: clamp(2rem, 5.5vw, 3rem);
  }
  .tool-hero__subtitle {
    font-size: clamp(1.02rem, 2.4vw, 1.2rem);
    color: var(--cc-muted);
  }
  .tool-content { margin-top: 1rem; }
  .tool-steps { counter-reset: step; }
  .tool-examples {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .tool-example {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    background: var(--cc-surface);
    border: 1px solid var(--cc-border);
    border-radius: var(--cc-radius-md);
  }
  .tool-example strong { color: var(--cc-text); }
  .tool-example span { color: var(--cc-muted); font-size: 0.95rem; }
  .tool-faq { margin-top: 3rem; }
  .tool-related { margin-top: 3rem; }
  @media (min-width: 640px) {
    .tool-examples { grid-template-columns: repeat(3, 1fr); }
  }
</style>
